APP_ENV=local
APP_SECRET_KEY=change-me-very-secret-jwt-key-minimum-32-chars
APP_ENCRYPTION_KEY=local-dev-encryption-key-32-chars
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=admin1234!
ADMIN_SESSION_MAX_AGE_SECONDS=28800
COOKIE_SECURE=false
DATABASE_URL=sqlite:///./data/chatbot.sqlite3

LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=mock-api-key
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_VISION_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small

RAG_BACKEND=rag_anything
RAG_WORKING_DIR=./data/rag
RAG_PARSER=mineru
RAG_PARSE_METHOD=auto

DASHBOARD_URL=http://localhost:8000
API_PUBLIC_URL=http://localhost:8000

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
MESSENGER_VERIFY_TOKEN=
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_APP_SECRET=
TELEGRAM_BOT_TOKEN=

OPS_POLL_SECONDS=60
WARNING_PERSIST_MINUTES=15
HUMAN_WAIT_WARNING_MINUTES=10
HUMAN_WAIT_CRITICAL_MINUTES=30
RAG_LATENCY_WARNING_MS=3000
RAG_LATENCY_CRITICAL_MS=8000
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

CONVERSATION_RETENTION_DAYS=365
INCIDENT_RETENTION_DAYS=730
AUDIT_RETENTION_DAYS=1095
